    "Choose “Clear” in the filter bar to show all videos again.": {
      "comment": "Empty state body — filter active; mentions the Clear button",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر “مسح” في شريط التصفية لإظهار جميع مقاطع الفيديو مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte „Smazat“ na liště filtrů, abyste znovu zobrazili všechna videa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Löschen“ in der Filterleiste, um alle Videos wieder anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige “Borrar” en la barra de filtros para volver a mostrar todos los vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez “Effacer” dans la barre de filtres pour afficher à nouveau toutes les vidéos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी वीडियो फिर से दिखाने के लिए फ़िल्टर बार में “साफ़ करें” चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih “Hapus” di bilah filter untuk menampilkan semua video kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli “Cancella” nella barra dei filtri per mostrare nuovamente tutti i video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての動画を再表示するには、フィルターバーで“クリア”を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 동영상을 다시 표시하려면 필터 바에서 “지우기”를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies “Wissen” in de filterbalk om alle video's weer te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Smazat“ na pasku filtrów, aby ponownie wyświetlić wszystkie filmy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha “Limpar” na barra de filtros para mostrar todos os vídeos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Очистить» на панели фильтров, чтобы снова показать все видео."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก “ล้าง” ในแถบตัวกรองเพื่อแสดงวิดีโอทั้งหมดอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm videoları yeniden göstermek için filtre çubuğunda “Temizle” seçeneğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Очистити» на панелі фільтрів, щоб знову показати всі відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn “Xóa” trong thanh lọc để hiển thị lại tất cả video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在筛选栏中选择“清除”以重新显示所有视频。"
          }
        }
      }
    },
