    "A video can’t be a proxy of itself": {
      "comment": "Error — user tried to set a video as proxy of itself",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لمقطع الفيديو أن يكون وكيلاً لنفسه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Video nemůže být proxy samo sebe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Video kann kein Proxy von sich selbst sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vídeo no puede ser proxy de sí mismo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vidéo ne peut pas être son propre proxy"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई वीडियो अपना प्रॉक्सी नहीं हो सकता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video tidak bisa menjadi proxy dirinya sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un video non può essere proxy di se stesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画は自分自身のプロキシにはなれません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상은 자신의 프록시가 될 수 없습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een video kan geen proxy van zichzelf zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film nie może być własnym proxy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um vídeo não pode ser proxy de si mesmo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео не может быть прокси самого себя"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอไม่สามารถเป็นพร็อกซีของตัวเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir video kendisinin proxy'si olamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео не може бути проксі самого себе"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video không thể là proxy của chính nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频不能是自身的代理"
          }
        }
      }
    },
    "Add videos by selecting them in the grid and choosing “Add to Collection”.": {
      "comment": "Empty state body — manual collection",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مقاطع الفيديو بتحديدها في الشبكة واختيار “إضافة إلى المجموعة”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte videa jejich výběrem v mřížce a volbou “Přidat do kolekce”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Videos hinzu, indem du sie im Raster auswählst und „Zur Sammlung hinzufügen“ wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade vídeos seleccionándolos en la cuadrícula y eligiendo “Añadir a colección”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des vidéos en les sélectionnant dans la grille et en choisissant “Ajouter à la collection”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रिड में वीडियो चुनें और “संग्रह में जोड़ें” चुनकर वीडियो जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan video dengan memilihnya di grid dan memilih “Tambahkan ke koleksi”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi video selezionandoli nella griglia e scegliendo “Aggiungi alla raccolta”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドでビデオを選択し、“コレクションに追加”を選んで追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리드에서 동영상을 선택하고 “컬렉션에 추가”를 선택하여 동영상을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg video's toe door ze in het raster te selecteren en “Toevoegen aan verzameling” te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj filmy, wybierając je w siatce i wybierając „Dodaj do kolekcji”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione vídeos selecionando-os na grade e escolhendo “Adicionar à coleção”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте видео, выбирая их в сетке и выбирая «Добавить в коллекцию»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มวิดีโอโดยเลือกในกริดและเลือก “เพิ่มลงในคอลเล็กชัน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoları kılavuzdaki seçip “Koleksiyona ekle” seçeneğini seçerek ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте відео, вибираючи їх у сітці та обираючи «Додати до колекції»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm video bằng cách chọn chúng trong lưới và chọn “Thêm vào bộ sưu tập”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网格中选择视频，然后选择“添加到合集”来添加视频。"
          }
        }
      }
    },
