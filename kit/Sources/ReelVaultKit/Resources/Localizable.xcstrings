      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مقطعَي فيديو على الأقل (Shift+نقر أو Cmd+نقر) لإنشاء مجموعة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte alespoň 2 videa (Shift+kliknutí nebo Cmd+kliknutí) pro vytvoření skupiny"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens 2 Videos (Umschalt+Klick oder Cmd+Klick) aus, um eine Gruppe zu erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona al menos 2 vídeos (Shift+clic o Cmd+clic) para crear un grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez au moins 2 vidéos (Maj+clic ou Cmd+clic) pour créer un groupe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ग्रुप बनाने के लिए कम से कम 2 वीडियो चुनें (Shift+क्लिक या Cmd+क्लिक)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih setidaknya 2 video (Shift+klik atau Cmd+klik) untuk membuat grup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona almeno 2 video (Shift+clic o Cmd+clic) per creare un gruppo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作成するには少なくとも2つの動画を選択してください (Shift+クリックまたはCmd+クリック)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 만들려면 동영상을 2개 이상 선택하세요 (Shift+클릭 또는 Cmd+클릭)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer ten minste 2 video's (Shift+klik of Cmd+klik) om een groep te maken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz co najmniej 2 filmy (Shift+klik lub Cmd+klik), aby utworzyć grupę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione pelo menos 2 vídeos (Shift+clique ou Cmd+clique) para criar um grupo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите не менее 2 видео (Shift+клик или Cmd+клик), чтобы создать группу"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวิดีโออย่างน้อย 2 รายการ (Shift+คลิก หรือ Cmd+คลิก) เพื่อสร้างกลุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir grup oluşturmak için en az 2 video seçin (Shift+tıklama veya Cmd+tıklama)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть не менше 2 відео (Shift+клік або Cmd+клік), щоб створити групу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ít nhất 2 video (Shift+nhấp hoặc Cmd+nhấp) để tạo nhóm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择至少 2 个视频（Shift+点击或 Cmd+点击）以创建组"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گروپ بنانے کے لیے کم از کم 2 ویڈیوز منتخب کریں (Shift+کلک یا Cmd+کلک)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রুপ তৈরি করতে কমপক্ষে ২টি ভিডিও নির্বাচন করুন (Shift+ক্লিক বা Cmd+ক্লিক)"
          }
        }
      }
