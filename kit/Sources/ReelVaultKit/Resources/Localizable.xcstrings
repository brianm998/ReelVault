    "Proxy videos cannot be added to a stack. Deselect the %@ and try again.": {
      "comment": "Error — %@ is 'it' or 'them' (the proxy video noun)",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إضافة مقاطع الفيديو الوكيلة إلى مجموعة. قم بإلغاء تحديد %@ وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy videa nelze přidat do zásobníku. Zrušte výběr %@ a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy-Videos können einem Stapel nicht hinzugefügt werden. Hebe die Auswahl von %@ auf und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos proxy no se pueden añadir a una pila. Deselecciona %@ e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos proxy ne peuvent pas être ajoutées à une pile. Désélectionnez %@ et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉक्सी वीडियो स्टैक में नहीं जोड़े जा सकते। %@ को अचयनित करें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video proxy tidak dapat ditambahkan ke tumpukan. Batalkan pilihan %@ dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video proxy non possono essere aggiunti a uno stack. Deseleziona %@ e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシ動画はスタックに追加できません。%@ の選択を解除してやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시 동영상은 스택에 추가할 수 없습니다. %@을(를) 선택 해제하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy-video's kunnen niet aan een stapel worden toegevoegd. Deselecteer %@ en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy proxy nie mogą być dodane do stosu. Odznacz %@ i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos proxy não podem ser adicionados a uma pilha. Desmarque %@ e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси-видео нельзя добавить в стек. Отмените выбор %@ и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอพร็อกซีไม่สามารถเพิ่มลงในสแต็กได้ ยกเลิกการเลือก %@ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy videolar bir gruba eklenemez. %@ seçimini kaldırın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проксі-відео не можна додати до стеку. Скасуйте вибір %@ і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video proxy không thể thêm vào ngăn xếp. Bỏ chọn %@ và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理视频无法添加到堆叠。请取消选择 %@ 后重试。"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پراکسی ویڈیوز کو اسٹیک میں شامل نہیں کیا جا سکتا۔ %@ کا انتخاب ہٹائیں اور دوبارہ کوشش کریں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রক্সি ভিডিও স্ট্যাকে যোগ করা যাবে না। %@ নির্বাচন বাতিল করে আবার চেষ্টা করুন।"
          }
        }
      }
    },
