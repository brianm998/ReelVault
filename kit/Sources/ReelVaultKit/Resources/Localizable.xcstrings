          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку + у верхній частині панелі «Бібліотека», щоб додати папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào nút + ở đầu bảng Thư viện để thêm thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
