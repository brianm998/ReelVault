    "Click the + button at the top of the Library panel to add a folder.": {
      "comment": "Empty state body — no library locations",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على زر + في أعلى لوحة المكتبة لإضافة مجلد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
