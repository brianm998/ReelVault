          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку «+» в верхней части панели «Библиотека», чтобы добавить папку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกปุ่ม + ที่ด้านบนของแผงไลบรารีเพื่อเพิ่มโฟลเดอร์"
          }
        },
        "tr": {
