# ReelVault iOS — the Xcode project is generated by XcodeGen from project.yml,
# so run `make project` after a fresh checkout or whenever project.yml changes.
PROJECT   = ReelVault.xcodeproj
SCHEME    = ReelVault
SIMDEST   = generic/platform=iOS Simulator
XCFRAMEWORK = Frameworks/ReelVaultCore.xcframework

.PHONY: project build archive clean xcframework

# Embedded Rust core, linked for on-device (Local Library) mode. Built once and
# reused; re-run after changing core/. PROFILE=release for shipping builds.
xcframework:
	./build-core-xcframework.sh

$(XCFRAMEWORK):
	./build-core-xcframework.sh

project:
	xcodegen generate

build: $(XCFRAMEWORK) project
	xcodebuild -project $(PROJECT) -scheme $(SCHEME) -sdk iphonesimulator \
	  -destination '$(SIMDEST)' CODE_SIGNING_ALLOWED=NO build

archive: $(XCFRAMEWORK) project
	xcodebuild -project $(PROJECT) -scheme $(SCHEME) -configuration Release \
	  -archivePath build/ReelVault.xcarchive archive

clean:
	rm -rf $(PROJECT) build $(XCFRAMEWORK)
