    "Uploading %@ video%@ to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Uploading %1$@ video%2$@ to %3$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ویڈیو%@ کو %@ پر اپ لوڈ کیا جا رہا ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ভিডিও%@ %@-এ আপলোড হচ্ছে।"
          }
        }
      }
    },
    "Uses ffmpeg to rewrite the file's creation_time metadata without re-encoding.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg کا استعمال کرتے ہوئے دوبارہ انکوڈ کیے بغیر فائل کے creation_time میٹا ڈیٹا کو دوبارہ لکھتا ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরায় এনকোড না করে ফাইলের creation_time মেটাডেটা পুনরায় লিখতে ffmpeg ব্যবহার করে।"
          }
        }
      }
    },
