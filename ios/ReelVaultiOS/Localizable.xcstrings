{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" will be permanently deleted. The videos in it will not be affected.": {},
    "\"%@\" will fall back to its raw model name after removal.": {},
    "\"%@\" will fall back to the built-in mapping after removal.": {},
    "\"%@\" will go back to showing its recorded name after removal.": {},
    "%@": {},
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ found": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পাওয়া গেছে"
          }
        }
      }
    },
    "%@ skipped — only Photos-library videos can be uploaded right now.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এড়িয়ে যাওয়া হয়েছে — এখন শুধুমাত্র Photos লাইব্রেরির ভিডিওগুলি আপলোড করা যাবে।"
          }
        }
      }
    },
