    "Metadata": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میٹا ڈیٹا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেটাডেটা"
          }
        }
      }
    },
    "Newly-generated proxies default to the proxy height. Smaller = faster and smaller files.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے بنائے گئے پراکسی بطور ڈیفالٹ پراکسی کی اونچائی پر ہوں گے۔ چھوٹا = تیز اور چھوٹی فائلیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন তৈরি প্রক্সিগুলি প্রক্সি উচ্চতায় ডিফল্ট হয়। ছোট = দ্রুততর এবং ছোট ফাইল।"
          }
        }
      }
    },
    "No camera metadata.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کیمرہ میٹا ڈیٹا نہیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ক্যামেরা মেটাডেটা নেই।"
          }
        }
      }
    },
    "No collections yet": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی مجموعہ نہیں"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো সংকলন নেই"
          }
        }
      }
    },
    "No collections yet.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی مجموعہ نہیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো সংকলন নেই।"
          }
        }
      }
    },
    "No date matches this pattern in the filename.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل نام میں اس نمونے سے کوئی تاریخ مطابقت نہیں رکھتی۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলের নামে এই প্যাটার্নের সাথে মিলে এমন কোনো তারিখ নেই।"
          }
        }
      }
    },
    "No lenses in the catalog yet.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیٹالاگ میں ابھی تک کوئی لینس نہیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাটালগে এখনও কোনো লেন্স নেই।"
          }
        }
      }
    },
    "No mappings yet. Tap + to add one.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی میپنگ نہیں۔ ایک شامل کرنے کے لیے + دبائیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো ম্যাপিং নেই। একটি যোগ করতে + চাপুন।"
          }
        }
      }
    },
    "No rules set — this collection matches every video.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اصول مقرر نہیں — یہ مجموعہ ہر ویڈیو سے مطابقت رکھتا ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো নিয়ম নির্ধারিত নেই — এই সংকলনটি প্রতিটি ভিডিওর সাথে মেলে।"
          }
        }
      }
    },
