    "Videos taller than the inline-playback ceiling are marked \"Too large to play here\" and offered a one-click proxy.": {},
    "Videos upload at full resolution to the server's import folder, then are indexed into the catalog.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویڈیوز مکمل ریزولوشن پر سرور کے امپورٹ فولڈر میں اپ لوڈ ہوتی ہیں، پھر کیٹلاگ میں انڈیکس کی جاتی ہیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিওগুলি পূর্ণ রেজোলিউশনে সার্ভারের ইমপোর্ট ফোল্ডারে আপলোড হয়, তারপর ক্যাটালগে ইন্ডেক্স করা হয়।"
          }
        }
      }
    },
    "Videos with GPS metadata appear here on the map.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS میٹا ڈیٹا والی ویڈیوز یہاں نقشے پر ظاہر ہوتی ہیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS মেটাডেটাযুক্ত ভিডিওগুলি এখানে মানচিত্রে দেখায়।"
          }
        }
      }
    },
    "Visuals": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بصری عناصر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিজ্যুয়ালস"
          }
        }
      }
    },
    "Watch videos you downloaded for offline use — no connection needed.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آف لائن استعمال کے لیے ڈاؤن لوڈ کی گئی ویڈیوز دیکھیں — کوئی کنکشن درکار نہیں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইনে ব্যবহারের জন্য ডাউনলোড করা ভিডিওগুলি দেখুন — কোনো সংযোগের প্রয়োজন নেই।"
          }
        }
      }
    },
    "When off, new files appear only after \"Scan Library\".": {},
    "While connected to a server, choose \"Download for Offline\" on a video to watch it here without a connection.": {},
    "Will save as: %@": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس طرح محفوظ ہوگا: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এভাবে সংরক্ষিত হবে: %@"
          }
        }
      }
    },
    "Write-settle delay": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رائٹ-سیٹل تاخیر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাইট-সেটল বিলম্ব"
          }
        }
      }
    },
    "Write-settle delay prevents indexing a recording while the camera or upload tool is still writing it. 5 s is fine for most workflows.": {
      "localizations": {
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رائٹ-سیٹل تاخیر ریکارڈنگ کو انڈیکس ہونے سے روکتی ہے جب کیمرہ یا اپ لوڈ ٹول ابھی لکھ رہا ہو۔ اکثر ورک فلوز کے لیے 5 s کافی ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাইট-সেটল বিলম্ব ক্যামেরা বা আপলোড টুল এখনও রেকর্ডিং লিখতে থাকাকালীন সেটি ইন্ডেক্স করা থেকে বিরত রাখে। বেশিরভাগ কার্যপ্রবাহের জন্য ৫ সেকেন্ড যথেষ্ট।"
          }
        }
      }
    }
  },
  "version": "1.0"
}
