          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групувати відео, що мають спільну базову назву, тривалість і частоту кадрів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
