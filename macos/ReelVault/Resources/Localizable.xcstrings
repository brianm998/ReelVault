    "Pairing failed — check the code and try again.": {
      "comment": "Connection error when pairing fails",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الإقران — تحقق من الرمز وحاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Párování selhalo — zkontrolujte kód a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplung fehlgeschlagen — Code prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de emparejamiento — verifica el código e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'appairage — vérifiez le code et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग विफल — कोड जांचें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembuatan pasangan gagal — periksa kode dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associazione fallita — controlla il codice e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング失敗 — コードを確認してもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 실패 — 코드를 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen mislukt — controleer de code en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parowanie nie powiodło się — sprawdź kod i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no emparelhamento — verifique o código e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка сопряжения — проверьте код и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
