    "Drag a row to reorder. Double-click in the grid opens the preferred variant. Click ⭐ to change preferred.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب صفًا لإعادة الترتيب. انقر نقرًا مزدوجًا في الشبكة لفتح المتغير المفضل. انقر ⭐ لتغيير المفضل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte řádek pro změnu pořadí. Dvojitý klik v mřížce otevře preferovanou variantu. Klikněte na ⭐ pro změnu preferované."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile ziehen zum Neuanordnen. Doppelklick im Raster öffnet die bevorzugte Variante. ⭐ klicken, um die bevorzugte zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una fila para reordenar. Doble clic en la cuadrícula abre la variante preferida. Haz clic en ⭐ para cambiar la preferida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une ligne pour réorganiser. Double-cliquez dans la grille pour ouvrir la variante préférée. Cliquez sur ⭐ pour changer la préférée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनः क्रमबद्ध करने के लिए एक पंक्ति खींचें। ग्रिड में डबल-क्लिक पसंदीदा वेरिएंट खोलता है। पसंदीदा बदलने के लिए ⭐ क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret baris untuk mengurutkan ulang. Klik dua kali di kisi membuka varian yang dipilih. Klik ⭐ untuk mengubah yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una riga per riordinare. Doppio clic nella griglia apre la variante preferita. Fai clic su ⭐ per cambiare la preferita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行をドラッグして並べ替えます。グリッドでダブルクリックすると優先バリアントが開きます。⭐ をクリックして優先バリアントを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 드래그하여 순서를 변경하세요. 그리드에서 두 번 클릭하면 기본 변형이 열립니다. ⭐를 클릭하여 기본값을 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een rij om te herordenen. Dubbelklik in het raster om de voorkeursvariant te openen. Klik op ⭐ om de voorkeur te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij wiersz, aby zmienić kolejność. Podwójne kliknięcie w siatce otwiera preferowany wariant. Kliknij ⭐, aby zmienić preferowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma linha para reordenar. Clique duplo na grade abre a variante preferida. Clique em ⭐ para alterar a preferida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите строку для изменения порядка. Двойной щелчок в сетке открывает предпочтительный вариант. Нажмите ⭐, чтобы изменить предпочтительный."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากแถวเพื่อเรียงลำดับ ดับเบิลคลิกในตารางเพื่อเปิดตัวแปรที่ต้องการ คลิก ⭐ เพื่อเปลี่ยนตัวแปรที่ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden sıralamak için bir satırı sürükleyin. Izgarada çift tıklama tercih edilen varyantı açar. Tercihliye değiştirmek için ⭐ tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть рядок для зміни порядку. Подвійний клік у сітці відкриває бажаний варіант. Натисніть ⭐ для зміни бажаного."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo một hàng để sắp xếp lại. Nhấp đúp trong lưới mở biến thể ưu tiên. Nhấp ⭐ để thay đổi ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动行以重新排序。在网格中双击可打开首选变体。点击 ⭐ 以更改首选项。"
          }
        }
      }
    },
    "Enter one or more directories. Use $YEAR in a path (e.g. /Volumes/Media/$YEAR/Raw) to add every matching year folder at once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مجلدًا واحدًا أو أكثر. استخدم $YEAR في المسار (مثلاً /Volumes/Media/$YEAR/Raw) لإضافة كل مجلد سنة مطابق دفعةً واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte jeden nebo více adresářů. Použijte $YEAR v cestě (např. /Volumes/Media/$YEAR/Raw) pro přidání všech odpovídajících složek roku najednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen oder mehrere Ordner eingeben. Verwenden Sie $YEAR in einem Pfad (z. B. /Volumes/Media/$YEAR/Raw), um alle passenden Jahresordner auf einmal hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce uno o más directorios. Usa $YEAR en una ruta (p. ej. /Volumes/Media/$YEAR/Raw) para añadir de una vez todas las carpetas de año coincidentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un ou plusieurs répertoires. Utilisez $YEAR dans un chemin (p. ex. /Volumes/Media/$YEAR/Raw) pour ajouter d'un coup tous les dossiers d'année correspondants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या अधिक डायरेक्टरी दर्ज करें। एक साथ सभी मेल खाने वाले वर्ष फ़ोल्डर जोड़ने के लिए पथ में $YEAR उपयोग करें (उदा. /Volumes/Media/$YEAR/Raw)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan satu atau lebih direktori. Gunakan $YEAR dalam jalur (mis. /Volumes/Media/$YEAR/Raw) untuk menambahkan setiap folder tahun yang cocok sekaligus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una o più directory. Usa $YEAR in un percorso (es. /Volumes/Media/$YEAR/Raw) per aggiungere in una volta tutte le cartelle degli anni corrispondenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ以上のディレクトリを入力してください。パスに $YEAR を使用すると（例：/Volumes/Media/$YEAR/Raw）、一致するすべての年フォルダを一括で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 디렉토리를 입력하세요. 경로에 $YEAR를 사용하면(예: /Volumes/Media/$YEAR/Raw) 일치하는 모든 연도 폴더를 한 번에 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een of meer mappen in. Gebruik $YEAR in een pad (bijv. /Volumes/Media/$YEAR/Raw) om alle overeenkomende jaarsmappen tegelijk toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź jeden lub więcej katalogów. Użyj $YEAR w ścieżce (np. /Volumes/Media/$YEAR/Raw), aby jednocześnie dodać wszystkie pasujące foldery roczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um ou mais diretórios. Use $YEAR em um caminho (ex.: /Volumes/Media/$YEAR/Raw) para adicionar todas as pastas de ano correspondentes de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите одну или несколько папок. Используйте $YEAR в пути (например, /Volumes/Media/$YEAR/Raw), чтобы сразу добавить все соответствующие папки по годам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนไดเรกทอรีหนึ่งรายการขึ้นไป ใช้ $YEAR ในเส้นทาง (เช่น /Volumes/Media/$YEAR/Raw) เพื่อเพิ่มโฟลเดอร์ปีที่ตรงกันทั้งหมดในครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veya daha fazla dizin girin. Eşleşen tüm yıl klasörlerini tek seferde eklemek için yolda $YEAR kullanın (örn. /Volumes/Media/$YEAR/Raw)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть один або кілька каталогів. Використовуйте $YEAR у шляху (напр. /Volumes/Media/$YEAR/Raw), щоб одразу додати всі відповідні папки року."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một hoặc nhiều thư mục. Dùng $YEAR trong đường dẫn (ví dụ: /Volumes/Media/$YEAR/Raw) để thêm tất cả các thư mục năm phù hợp cùng lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入一个或多个目录。在路径中使用 $YEAR（例如 /Volumes/Media/$YEAR/Raw）可一次添加所有匹配的年份文件夹。"
          }
        }
      }
    },
