    "Videos at this spot (within the place's radius) will show this name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعرض الفيديوهات في هذا الموقع (ضمن نطاق المكان) هذا الاسم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Videa na tomto místě (v okruhu místa) zobrazí tento název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos an diesem Ort (innerhalb des Platzradius) zeigen diesen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos en este lugar (dentro del radio del lugar) mostrarán este nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos à cet endroit (dans le rayon du lieu) afficheront ce nom."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्थान पर (स्थान की त्रिज्या के भीतर) वीडियो यह नाम दिखाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video di tempat ini (dalam radius lokasi) akan menampilkan nama ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video in questo punto (entro il raggio del luogo) mostreranno questo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地点（場所の半径内）の動画にはこの名前が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지점(장소의 반경 내)에 있는 동영상에 이 이름이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video''s op deze locatie (binnen de straal van de plaats) tonen deze naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy w tym miejscu (w promieniu miejsca) będą wyświetlać tę nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos neste local (dentro do raio do lugar) exibirão este nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео в этом месте (в радиусе места) будут отображаться с этим именем."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอที่จุดนี้ (ภายในรัศมีของสถานที่) จะแสดงชื่อนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu noktadaki videolar (yerin yarıçapı içinde) bu adı gösterecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео в цьому місці (в межах радіуса місця) відображатимуть цю назву."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các video tại vị trí này (trong bán kính của địa điểm) sẽ hiển thị tên này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此位置（在该地点半径范围内）的视频将显示此名称。"
          }
        }
      }
    },
    "Videos with GPS metadata appear here as pins.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الفيديوهات التي تحتوي على بيانات GPS هنا كدبابيس."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Videa s GPS metadaty se zde zobrazí jako špendlíky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos mit GPS-Metadaten erscheinen hier als Markierungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos con metadatos GPS aparecen aquí como marcadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos avec des métadonnées GPS apparaissent ici sous forme d'épingles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS मेटाडेटा वाले वीडियो यहां पिन के रूप में दिखाई देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video dengan metadata GPS muncul di sini sebagai pin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video con metadati GPS appaiono qui come segnaposto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS メタデータを持つ動画がピンとして表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS 메타데이터가 있는 동영상이 여기에 핀으로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video''s met GPS-metadata verschijnen hier als pins."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy z metadanymi GPS pojawiają się tutaj jako pinezki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos com metadados GPS aparecem aqui como marcadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео с метаданными GPS отображаются здесь в виде меток."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอที่มีข้อมูลเมตา GPS จะปรากฏที่นี่เป็นหมุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS meta verisi olan videolar burada pin olarak görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео з метаданими GPS відображаються тут як маркери."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các video có siêu dữ liệu GPS xuất hiện tại đây dưới dạng ghim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带有 GPS 元数据的视频将以图钉形式显示在此处。"
          }
        }
      }
    },
    "Watch your library locations for new and changed files": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراقبة مواقع المكتبة بحثًا عن الملفات الجديدة والمعدَّلة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovat umístění knihovny pro nové a změněné soubory"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheksorte auf neue und geänderte Dateien überwachen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervisar las ubicaciones de la biblioteca en busca de archivos nuevos y modificados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveiller les emplacements de votre bibliothèque pour les fichiers nouveaux et modifiés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई और बदली हुई फ़ाइलों के लिए अपने लाइब्रेरी स्थानों की निगरानी करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau lokasi perpustakaan Anda untuk file baru dan yang berubah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora le posizioni della libreria per file nuovi e modificati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの場所で新規および変更されたファイルを監視する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 파일 및 변경된 파일을 라이브러리 위치에서 감시"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bibliotheeklocaties bewaken op nieuwe en gewijzigde bestanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoruj lokalizacje biblioteki pod kątem nowych i zmienionych plików"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorar os locais da biblioteca para arquivos novos e alterados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживать расположения медиатеки на наличие новых и изменённых файлов"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบตำแหน่งไลบรารีของคุณสำหรับไฟล์ใหม่และไฟล์ที่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ve değiştirilmiş dosyalar için kitaplık konumlarınızı izleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стежити за розташуваннями бібліотеки для нових і змінених файлів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi các vị trí thư viện của bạn để phát hiện tệp mới và đã thay đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监控媒体库位置中的新增和变更文件"
          }
        }
      }
    },
    "When off, only video files directly in this folder are indexed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التعطيل، تُفهرس فقط ملفات الفيديو الموجودة مباشرةً في هذا المجلد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je vypnuto, jsou indexovány pouze soubory videa přímo v této složce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, werden nur Videodateien direkt in diesem Ordner indiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, solo se indexan los archivos de vídeo directamente en esta carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, seuls les fichiers vidéo directement dans ce dossier sont indexés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, केवल इस फ़ोल्डर में सीधे स्थित वीडियो फ़ाइलें अनुक्रमित होती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dinonaktifkan, hanya file video yang langsung ada di folder ini yang diindeks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, vengono indicizzati solo i file video direttamente in questa cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、このフォルダ直下にある動画ファイルのみがインデックスされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있으면 이 폴더에 직접 있는 동영상 파일만 인덱싱됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer uitgeschakeld, worden alleen videobestanden direct in deze map geïndexeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, indeksowane są tylko pliki wideo bezpośrednio w tym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, apenas os arquivos de vídeo diretamente nesta pasta são indexados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отключении индексируются только видеофайлы непосредственно в этой папке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิด จะจัดทำดัชนีเฉพาะไฟล์วิดีโอที่อยู่ในโฟลเดอร์นี้โดยตรงเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken, yalnızca doğrudan bu klasördeki video dosyaları dizine eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, індексуються лише відеофайли безпосередньо в цій папці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, chỉ các tệp video trực tiếp trong thư mục này được lập chỉ mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，仅索引直接位于此文件夹中的视频文件。"
          }
        }
      }
    },
