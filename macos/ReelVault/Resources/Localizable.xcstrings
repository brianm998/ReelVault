    "Captures the current filter settings (camera, codec, rating, etc.) as a smart collection that updates automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ إعدادات التصفية الحالية (الكاميرا والترميز والتقييم وغيرها) كمجموعة ذكية تُحدَّث تلقائيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachycuje aktuální nastavení filtru (fotoaparát, kodek, hodnocení atd.) jako inteligentní kolekci, která se aktualizuje automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert die aktuellen Filtereinstellungen (Kamera, Codec, Bewertung usw.) als Smart-Sammlung, die sich automatisch aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la configuración de filtros actual (cámara, códec, valoración, etc.) como una colección inteligente que se actualiza automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les paramètres de filtre actuels (appareil, codec, évaluation, etc.) en tant que collection dynamique mise à jour automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान फ़िल्टर सेटिंग्स (कैमरा, codec, रेटिंग, आदि) को एक स्मार्ट संग्रह के रूप में कैप्चर करता है जो स्वचालित रूप से अपडेट होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan pengaturan filter saat ini (kamera, codec, penilaian, dll.) sebagai koleksi cerdas yang diperbarui secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisisce le impostazioni filtro correnti (fotocamera, codec, valutazione, ecc.) come collezione intelligente che si aggiorna automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のフィルター設定（カメラ、コーデック、レーティングなど）を自動更新されるスマートコレクションとして保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 필터 설정(카메라, 코덱, 평점 등)을 자동으로 업데이트되는 스마트 컬렉션으로 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt de huidige filterinstellingen (camera, codec, beoordeling, enz.) vast als een slimme collectie die automatisch wordt bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje bieżące ustawienia filtrów (kamera, kodek, ocena itp.) jako inteligentną kolekcję, która aktualizuje się automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura as configurações de filtro atuais (câmera, codec, avaliação, etc.) como uma coleção inteligente que se atualiza automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет текущие настройки фильтра (камера, кодек, рейтинг и т. д.) как смарт-коллекцию, которая обновляется автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการตั้งค่าตัวกรองปัจจุบัน (กล้อง codec คะแนน ฯลฯ) เป็นคอลเลกชันอัจฉริยะที่อัปเดตโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut filtre ayarlarını (kamera, codec, derecelendirme vb.) otomatik güncellenen bir akıllı koleksiyon olarak kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає поточні параметри фільтра (камера, кодек, рейтинг тощо) як розумну колекцію, що оновлюється автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu các cài đặt bộ lọc hiện tại (máy quay, codec, xếp hạng, v.v.) dưới dạng bộ sưu tập thông minh tự động cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前筛选条件（相机、编解码器、评分等）保存为自动更新的智能合集。"
          }
        }
      }
    },
    "Catalog-wide auto-tagging and detection settings": {
      "localizations": {
