        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá ffmpeg k přepsání metadat creation_time souboru bez překódování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet ffmpeg, um die creation_time-Metadaten der Datei ohne Neukodierung neu zu schreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ffmpeg para reescribir los metadatos creation_time del archivo sin recodificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise ffmpeg pour réécrire les métadonnées creation_time du fichier sans recodage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनः एन्कोड किए बिना फ़ाइल के creation_time मेटाडेटा को पुनः लिखने के लिए ffmpeg का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan ffmpeg untuk menulis ulang metadata creation_time file tanpa pengkodean ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ffmpeg per riscrivere i metadati creation_time del file senza ricodifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpegを使用して、再エンコードなしにファイルのcreation_timeメタデータを書き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재인코딩 없이 ffmpeg를 사용하여 파일의 creation_time 메타데이터를 다시 씁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt ffmpeg om de creation_time-metadata van het bestand te herschrijven zonder hercodering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa ffmpeg do przepisania metadanych creation_time pliku bez ponownego kodowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ffmpeg para reescrever os metadados creation_time do arquivo sem recodificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует ffmpeg для перезаписи метаданных creation_time файла без перекодирования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ ffmpeg เพื่อเขียนข้อมูล creation_time ของไฟล์ใหม่โดยไม่ต้องเข้ารหัสใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kodlamadan dosyanın creation_time meta verilerini yeniden yazmak için ffmpeg kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує ffmpeg для перезапису метаданих creation_time файлу без перекодування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng ffmpeg để ghi lại siêu dữ liệu creation_time của tệp mà không cần mã hóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ffmpeg 在不重新编码的情况下重写文件的 creation_time 元数据。"
