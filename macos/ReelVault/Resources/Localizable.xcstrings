        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vašem iPhone nebo iPadu otevřete ReelVault, vyberte server tohoto počítače a zadejte:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf Ihrem iPhone oder iPad ReelVault, wählen Sie den Server dieses Computers und geben Sie dann ein:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu iPhone o iPad, abre ReelVault, elige el servidor de este ordenador y luego introduce:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre iPhone ou iPad, ouvrez ReelVault, choisissez le serveur de cet ordinateur, puis saisissez :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone या iPad पर ReelVault खोलें, इस कंप्यूटर का सर्वर चुनें, फिर दर्ज करें:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone atau iPad Anda, buka ReelVault, pilih server komputer ini, lalu masukkan:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul tuo iPhone o iPad, apri ReelVault, scegli il server di questo computer, quindi inserisci:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone または iPad で ReelVault を開き、このコンピューターのサーバーを選択して、次を入力してください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad에서 ReelVault를 열고, 이 컴퓨터의 서버를 선택한 후 입력하세요:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ReelVault op uw iPhone of iPad, kies de server van deze computer en voer in:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na swoim iPhonie lub iPadzie otwórz ReelVault, wybierz serwer tego komputera, a następnie wprowadź:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu iPhone ou iPad, abra o ReelVault, escolha o servidor deste computador e insira:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone или iPad откройте ReelVault, выберите сервер этого компьютера, затем введите:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone หรือ iPad ของคุณ เปิด ReelVault เลือกเซิร์ฟเวอร์ของคอมพิวเตอร์เครื่องนี้ แล้วป้อน:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone veya iPad'inizde ReelVault'u açın, bu bilgisayarın sunucusunu seçin, ardından girin:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому iPhone або iPad відкрийте ReelVault, виберіть сервер цього комп'ютера, потім введіть:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iPhone hoặc iPad của bạn, mở ReelVault, chọn máy chủ của máy tính này, sau đó nhập:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的 iPhone 或 iPad 上，打开 ReelVault，选择此电脑的服务器，然后输入："
          }
        }
      }
    },
    "Only applied when the file has no capture date in its metadata.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق فقط عندما لا يحتوي الملف على تاريخ التقاط في بيانات التعريف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije se pouze tehdy, když soubor nemá v metadatech datum pořízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur angewendet, wenn die Datei kein Aufnahmedatum in den Metadaten hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica cuando el archivo no tiene fecha de captura en sus metadatos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué uniquement lorsque le fichier ne contient pas de date de capture dans ses métadonnées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तभी लागू होता है जब फ़ाइल के मेटाडेटा में कोई कैप्चर दिनांक नहीं होती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya diterapkan ketika file tidak memiliki tanggal pengambilan dalam metadatanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato solo quando il file non ha una data di acquisizione nei suoi metadati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのメタデータに撮影日がない場合にのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일의 메타데이터에 촬영 날짜가 없을 때만 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen toegepast wanneer het bestand geen opnamedatum in de metadata heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosowane tylko wtedy, gdy plik nie ma daty rejestracji w metadanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado somente quando o arquivo não tem data de captura em seus metadados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется только если в метаданных файла отсутствует дата съёмки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะเมื่อไฟล์ไม่มีวันที่ถ่ายในข้อมูลเมตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca dosyanın meta verilerinde çekim tarihi olmadığında uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується лише тоді, коли файл не має дати захоплення в метаданих."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ áp dụng khi tệp không có ngày chụp trong siêu dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在文件元数据中没有拍摄日期时应用。"
          }
        }
      }
    },
    "Pair a New Device": {
      "localizations": {
        "ar": {
          "stringUnit": {
