    "Stack videos that share a base name, duration, and frame rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكديس الفيديوهات التي تشترك في الاسم الأساسي والمدة ومعدل الإطارات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seskupit videa se stejným základním názvem, délkou a snímkovou frekvencí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos mit gleichem Basisnamen, gleicher Dauer und Bildrate stapeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa vídeos que comparten nombre base, duración y velocidad de fotogramas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regrouper les vidéos partageant le même nom de base, la même durée et la même fréquence d'images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे वीडियो स्टैक करें जो एक मूल नाम, अवधि और फ्रेम दर साझा करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumpuk video yang berbagi nama dasar, durasi, dan frame rate."
          }
