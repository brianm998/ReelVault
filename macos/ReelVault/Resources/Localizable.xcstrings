    "A catalog is the SQLite file ReelVault uses to remember your library — locations, tags, notes, thumbnails. Each catalog is independent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتالوج هو ملف SQLite الذي يستخدمه ReelVault لتذكر مكتبتك — المواقع والعلامات والملاحظات والصور المصغرة. كل كتالوج مستقل بذاته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog je soubor SQLite, který ReelVault používá k zapamatování vaší knihovny — umístění, štítky, poznámky, miniatury. Každý katalog je nezávislý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Katalog ist die SQLite-Datei, die ReelVault verwendet, um Ihre Bibliothek zu speichern – Speicherorte, Tags, Notizen, Vorschaubilder. Jeder Katalog ist unabhängig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un catálogo es el archivo SQLite que ReelVault usa para recordar tu biblioteca: ubicaciones, etiquetas, notas y miniaturas. Cada catálogo es independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un catalogue est le fichier SQLite que ReelVault utilise pour mémoriser votre bibliothèque — emplacements, mots-clés, notes, vignettes. Chaque catalogue est indépendant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैटलॉग वह SQLite फ़ाइल है जिसे ReelVault आपकी लाइब्रेरी — स्थान, टैग, नोट्स, थंबनेल — याद रखने के लिए उपयोग करता है। प्रत्येक कैटलॉग स्वतंत्र होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog adalah file SQLite yang digunakan ReelVault untuk mengingat perpustakaan Anda — lokasi, tag, catatan, thumbnail. Setiap katalog bersifat independen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un catalogo è il file SQLite che ReelVault usa per ricordare la tua libreria — posizioni, tag, note, miniature. Ogni catalogo è indipendente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログは、ReelVault がライブラリ（場所、タグ、メモ、サムネイル）を記録するために使用する SQLite ファイルです。各カタログは独立しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카탈로그는 ReelVault가 라이브러리를 기억하는 데 사용하는 SQLite 파일입니다 — 위치, 태그, 메모, 썸네일 등. 각 카탈로그는 독립적입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een catalogus is het SQLite-bestand dat ReelVault gebruikt om uw bibliotheek te onthouden — locaties, tags, notities, miniaturen. Elke catalogus is onafhankelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog to plik SQLite, którego ReelVault używa do zapamiętywania biblioteki — lokalizacji, tagów, notatek, miniatur. Każdy katalog jest niezależny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um catálogo é o arquivo SQLite que o ReelVault usa para memorizar sua biblioteca — locais, tags, notas, miniaturas. Cada catálogo é independente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог — это SQLite-файл, в котором ReelVault хранит данные вашей медиатеки: расположение файлов, теги, заметки, миниатюры. Каждый каталог независим."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคตตาล็อกคือไฟล์ SQLite ที่ ReelVault ใช้จดจำไลบรารีของคุณ — ตำแหน่ง แท็ก บันทึก ภาพขนาดย่อ แคตตาล็อกแต่ละรายการเป็นอิสระจากกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog, ReelVault'un kitaplığınızı hatırlamak için kullandığı SQLite dosyasıdır — konumlar, etiketler, notlar, küçük resimler. Her katalog bağımsızdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог — це файл SQLite, який ReelVault використовує для збереження вашої бібліотеки: розташування, теги, нотатки, мініатюри. Кожен каталог є незалежним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục là tệp SQLite mà ReelVault dùng để ghi nhớ thư viện của bạn — vị trí, thẻ, ghi chú, hình thu nhỏ. Mỗi danh mục độc lập với nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录是 ReelVault 用于记录您的媒体库的 SQLite 文件，包含位置、标签、备注和缩略图。每个目录相互独立。"
          }
        }
      }
    },
