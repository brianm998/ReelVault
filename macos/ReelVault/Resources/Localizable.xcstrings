    "The ReelVault server is no longer reachable. You can browse your downloaded videos offline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد خادم ReelVault متاحًا. يمكنك تصفح الفيديوهات المحملة دون اتصال."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ReelVault již není dostupný. Můžete procházet stažená videa offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ReelVault-Server ist nicht mehr erreichbar. Sie können Ihre heruntergeladenen Videos offline durchsuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de ReelVault ya no está disponible. Puedes explorar tus vídeos descargados sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ReelVault n'est plus accessible. Vous pouvez parcourir vos vidéos téléchargées hors connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelVault सर्वर अब पहुंच योग्य नहीं है। आप अपने डाउनलोड किए गए वीडियो ऑफलाइन ब्राउज़ कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ReelVault tidak lagi dapat dijangkau. Anda dapat menelusuri video yang diunduh secara offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ReelVault non è più raggiungibile. Puoi sfogliare i video scaricati offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelVault サーバーに接続できません。ダウンロードした動画をオフラインで閲覧できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelVault 서버에 더 이상 연결할 수 없습니다. 다운로드한 동영상을 오프라인으로 탐색할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ReelVault-server is niet meer bereikbaar. U kunt uw gedownloade video''s offline bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer ReelVault jest niedostępny. Możesz przeglądać pobrane filmy w trybie offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor ReelVault não está mais acessível. Você pode navegar pelos seus vídeos baixados offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ReelVault недоступен. Вы можете просматривать загруженные видео в автономном режиме."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงเซิร์ฟเวอร์ ReelVault ได้อีกต่อไป คุณสามารถดูวิดีโอที่ดาวน์โหลดไว้แบบออฟไลน์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelVault sunucusuna artık ulaşılamıyor. İndirilen videolarınıza çevrimdışı göz atabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ReelVault більше недоступний. Ви можете переглядати завантажені відео у режимі офлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ ReelVault không còn truy cập được. Bạn có thể duyệt video đã tải xuống ở chế độ ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelVault 服务器已无法连接。您可以离线浏览已下载的视频。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
