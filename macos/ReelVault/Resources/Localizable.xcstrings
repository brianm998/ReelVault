    "Couldn't start the ReelVault backend. Set REELVAULT_CORE_BIN or build core with `cargo build`.": {
      "comment": "Connection error when local daemon can't start",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تشغيل الخلفية. عيّن REELVAULT_CORE_BIN أو أنشئ core بـ `cargo build`."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
