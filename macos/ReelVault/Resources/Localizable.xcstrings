    "Couldn't generate a pairing code. Make sure a ReelVault catalog is open and the daemon is running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء رمز الاقتران. تأكد من فتح كتالوج ReelVault وتشغيل الخدمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se vygenerovat párovací kód. Zkontrolujte, zda je otevřen katalog ReelVault a zda běží démon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein Kopplungscode generiert werden. Stellen Sie sicher, dass ein ReelVault-Katalog geöffnet und der Daemon aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo generar un código de emparejamiento. Asegúrate de que hay un catálogo de ReelVault abierto y el daemon está en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de générer un code de jumelage. Assurez-vous qu'un catalogue ReelVault est ouvert et que le démon est en cours d'exécution."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग कोड उत्पन्न नहीं हो सका। सुनिश्चित करें कि एक ReelVault कैटलॉग खुला है और डेमन चल रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuat kode pemasangan. Pastikan katalog ReelVault terbuka dan daemon sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile generare un codice di associazione. Assicurati che un catalogo ReelVault sia aperto e che il daemon sia in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードを生成できませんでした。ReelVault カタログが開いており、デーモンが実行中であることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드를 생성할 수 없습니다. ReelVault 카탈로그가 열려 있고 데몬이 실행 중인지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen koppelcode genereren. Zorg ervoor dat een ReelVault-catalogus open is en de daemon actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wygenerować kodu parowania. Upewnij się, że katalog ReelVault jest otwarty i demon jest uruchomiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar um código de pareamento. Verifique se um catálogo do ReelVault está aberto e se o daemon está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сгенерировать код сопряжения. Убедитесь, что каталог ReelVault открыт и служба запущена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถสร้างรหัสจับคู่ได้ ตรวจสอบให้แน่ใจว่าแคตตาล็อก ReelVault เปิดอยู่และ daemon กำลังทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşme kodu oluşturulamadı. Bir ReelVault kataloğunun açık ve arka plan hizmetinin çalıştığından emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося згенерувати код з'єднання. Переконайтеся, що каталог ReelVault відкрито та демон запущено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo mã ghép nối. Hãy đảm bảo danh mục ReelVault đang mở và daemon đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成配对码。请确保 ReelVault 目录已打开且后台服务正在运行。"
          }
        }
      }
    },
