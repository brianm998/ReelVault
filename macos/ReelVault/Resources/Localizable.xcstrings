    "Clears this device's pairing token. You'll need to enter a new pairing code to reconnect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح رمز الإقران لهذا الجهاز. ستحتاج إلى إدخال رمز إقران جديد لإعادة الاتصال."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže párovací token tohoto zařízení. Pro opětovné připojení bude nutné zadat nový párovací kód."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht das Kopplungs-Token dieses Geräts. Sie müssen einen neuen Kopplungscode eingeben, um die Verbindung wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el token de emparejamiento de este dispositivo. Deberás ingresar un nuevo código de emparejamiento para volver a conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le jeton de couplage de cet appareil. Vous devrez saisir un nouveau code de couplage pour vous reconnecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का पेयरिंग टोकन हटा देता है। फिर से कनेक्ट करने के लिए आपको एक नया पेयरिंग कोड दर्ज करना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus token pemasangan perangkat ini. Anda perlu memasukkan kode pemasangan baru untuk menyambung kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella il token di accoppiamento di questo dispositivo. Sarà necessario inserire un nuovo codice di accoppiamento per riconnettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのペアリングトークンをクリアします。再接続するには新しいペアリングコードを入力する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 페어링 토큰을 삭제합니다. 다시 연결하려면 새 페어링 코드를 입력해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist het koppeltoken van dit apparaat. Je moet een nieuwe koppelcode invoeren om opnieuw verbinding te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa token parowania tego urządzenia. Aby ponownie się połączyć, musisz wprowadzić nowy kod parowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o token de emparelhamento deste dispositivo. Você precisará inserir um novo código de emparelhamento para reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет токен сопряжения устройства. Для повторного подключения потребуется ввести новый код сопряжения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างโทเค็นการจับคู่ของอุปกรณ์นี้ คุณจะต้องป้อนรหัสการจับคู่ใหม่เพื่อเชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazın eşleşme belirteci temizlenir. Yeniden bağlanmak için yeni bir eşleşme kodu girmeniz gerekecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє токен з'єднання цього пристрою. Для повторного підключення потрібно буде ввести новий код з'єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mã ghép nối của thiết bị này. Bạn sẽ cần nhập mã ghép nối mới để kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此设备的配对令牌。重新连接需要输入新的配对码。"
          }
        }
      }
    },
