    "Code expired — close and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز — أغلق وأعد المحاولة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kódu vypršela — zavřete a zkuste znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code abgelaufen – schließen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código ha expirado — cierra e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code expiré — fermez et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड समाप्त हो गया — बंद करें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode kadaluarsa — tutup dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice scaduto — chiudi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの有効期限が切れました — 閉じてやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 만료되었습니다 — 닫고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Code verlopen — sluit en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod wygasł — zamknij i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código expirado — feche e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия кода истёк — закройте и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสหมดอายุ — ปิดและลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod süresi doldu — kapatın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Код застарів — закрийте та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đã hết hạn — đóng lại và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码已过期 — 请关闭后重试。"
          }
        }
      }
