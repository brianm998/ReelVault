<resources>
    <!-- Dark background to prevent white-flash before Compose renders.
         statusBarColor + windowLightStatusBar force dark icons off. -->
    <style name="Theme.ReelVault" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF1C1C1C</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.ReelVault.NoActionBar" parent="Theme.ReelVault" />
</resources>
