<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ReelVault Core — macOS LaunchDaemon

  Install:
    sudo cp com.reelvault.core.plist /Library/LaunchDaemons/
    sudo launchctl load -w /Library/LaunchDaemons/com.reelvault.core.plist

  Uninstall:
    sudo launchctl unload -w /Library/LaunchDaemons/com.reelvault.core.plist
    sudo rm /Library/LaunchDaemons/com.reelvault.core.plist

  Logs:
    /Library/Logs/ReelVault/reelvault-core.log   (structured, from --system-daemon)
    /Library/Logs/ReelVault/stdout.log           (stdout fallback)
    /Library/Logs/ReelVault/stderr.log           (stderr fallback)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.reelvault.core</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/reelvault-core</string>
        <string>--system-daemon</string>
        <string>--port</string>
        <string>50051</string>
    </array>

    <!-- Start at boot and keep alive if it crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Secondary log capture; the daemon also writes its own log file. -->
    <key>StandardOutPath</key>
    <string>/Library/Logs/ReelVault/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/ReelVault/stderr.log</string>

    <!-- Catalog lives in the shared system Application Support directory. -->
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/ReelVault</string>
</dict>
</plist>
